# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=jobpilot.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
SITE_NAME=JobPilot
# Shown on the privacy policy and terms; replace the placeholders before launch.
COMPANY_NAME=[Company name]
CONTACT_EMAIL=hello@example.com
# Days an invite stays valid
INVITE_EXPIRY_DAYS=14

# --- Database ---
DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot

# --- Storage / Huey ---
# largest CV upload accepted, in bytes (default 5 MB)
CV_MAX_UPLOAD_BYTES=5242880
PRIVATE_MEDIA_ROOT=./var/private
HUEY_DB_PATH=./var/huey.db
# lower (e.g. 1) in dev to watch the heartbeat quickly
HEARTBEAT_INTERVAL_MINUTES=10

# --- Email (outbound) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=JobPilot <no-reply@example.com>

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM ---
# fake | openai_compat
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_WRITER=
# e.g. {"model-name": {"input_per_mtok": 0.15, "output_per_mtok": 0.60}}
LLM_PRICES_JSON={}
LLM_LOG_BODIES=False
LLM_SYSTEM_DAILY_USD_CAP=1.00
# seconds to wait for the provider
LLM_TIMEOUT_SECONDS=60
# send response_format=json_object; set False if your provider rejects it
LLM_JSON_MODE=True
# OpenAI newer models need max_completion_tokens; most others use max_tokens
LLM_MAX_TOKENS_PARAM=max_tokens
QUOTA_DEFAULT_MONTHLY_SCORES=600
QUOTA_DEFAULT_MONTHLY_KITS=40
QUOTA_DEFAULT_MONTHLY_MANUAL=60
QUOTA_DEFAULT_MONTHLY_USD=3.00

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Inbound email ---
INBOUND_EMAIL_DOMAIN=alerts.example.com
INBOUND_IMAP_HOST=imap.gmail.com
INBOUND_IMAP_USER=
INBOUND_IMAP_PASSWORD=

# --- Scraping ---
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; JobPilot/1.0; +https://example.com/bot)
# seconds to wait between requests to the same site (keep at 1.5 or more)
SCRAPER_DELAY_SECONDS=1.5
# days a scraped job may go unseen before it expires
JOB_EXPIRY_DAYS=7

# --- Logging ---
LOG_LEVEL=INFO
# console (dev) | json (prod)
LOG_FORMAT=console
# set to git SHA in CI/CD builds
APP_RELEASE=dev
# web | worker | bot (set per container in prod)
SERVICE_NAME=web

# --- Monitoring / backups (prod) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
HEALTHCHECKS_PING_URL=
BACKUP_RCLONE_REMOTE=

# --- Production only ---
# raise once HTTPS is proven stable
SECURE_HSTS_SECONDS=3600

# --- Docker Compose (dev) ---
# Host port for the Postgres container; change it (and DATABASE_URL) if 5432 is already in use.
DB_PORT=5432
